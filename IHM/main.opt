# Styles généraux (thème sombre, voir theme.py)
*background : #0f172a
*foreground : #e2e8f0
*font : {Segoe UI} 10
*highlightThickness : 0

# Boutons
*Button.background : #3b82f6
*Button.foreground : white
*Button.activeBackground : #2563eb
*Button.activeForeground : white
*Button.relief : flat
*Button.borderWidth : 0
*Button.cursor : hand2
*Button.font : {Segoe UI} 10 bold

# Scale
*Scale.background : #0f172a
*Scale.foreground : #94a3b8
*Scale.troughColor : #334155
*Scale.activeBackground : #60a5fa
*Scale.sliderRelief : flat
*Scale.sliderLength : 18
*Scale.width : 10
*Scale.borderWidth : 0
*Scale.highlightThickness : 0
*Scale.font : {Segoe UI} 9

# Labels
*Label.foreground : #e2e8f0

# Cadres
*Labelframe.foreground : #94a3b8
*Labelframe.font : {Segoe UI} 10 bold
*Labelframe.relief : flat
*Labelframe.borderWidth : 0
*Labelframe.highlightThickness : 1
*Labelframe.highlightBackground : #334155
*Labelframe.highlightColor : #334155
*Labelframe.padX : 10
*Labelframe.padY : 8
*Labelframe.text : IPS

# Menus
*Menu.background : #1e293b
*Menu.foreground : #e2e8f0
*Menu.activeBackground : #3b82f6
*Menu.activeForeground : white
*Menu.relief : flat
